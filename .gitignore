# BMad installer (local only - docs.bmad-method.org)
/_bmad/
/.agents/
/.github/agents/
/_bmad-output/
/design-artifacts/

# Tender reference library (sensitive bid material — keep local unless policy allows)
docs/tender-reference/source/
docs/tender-reference/extracted/
