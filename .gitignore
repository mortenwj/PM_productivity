# Generated outputs (structure only in git)
outputs/*
!outputs/README.md
!outputs/**/.gitkeep

# Local spreadsheets, archives, and scratch at repo root
/*.xlsx
/*.zip

# Office lock / temp files
~$*
**/~$*

# Word exports when markdown is canonical in git
docs/**/*.docx

# RFP unpack scratch
rfp_docx_extract/

# Canvas local typings (Cursor provides these)
canvases/node_modules/

# Skill sync metadata (machine-local)
.cursor/skills/**/.sync-state.json

# Toolkit scratch and caches
toolkit/**/__pycache__/
toolkit/scripts/_*.txt
