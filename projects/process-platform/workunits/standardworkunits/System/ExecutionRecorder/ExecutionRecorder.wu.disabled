<workUnit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
          xsi:noNamespaceSchemaLocation= "..\..\WorkUnit.xsd"
          id="1BE85AD9-ED21-4DCB-AFAF-AE692EE4C0E6"
          displayName="Record execution" 
          visibility="public">
  <description>...</description>
  <categories>
    <category>Support</category>
  </categories>
  <executable assemblyType="SI.Biz.Recording.Backing.ExecutionRecorder, SI.Biz.Recording.Backing">
    <invoke>
      <arguments>
        <argument name="EventArgs" type="object"/>
		    <argument name="ReadOnlyRoutings" type="string">
          *.GenericManager/MetaQuery,
          *.GenericManager/MetaCount,
          */GetInsertableTypes
        </argument>
        <argument name="IgnoreAllwaysRoutings" type="string">
          *.StateHandler/*,
          *.SettingManager/*,
          *.SystemInfoHandler/*
        </argument>
      </arguments> 
    </invoke>
  </executable>
  <event shim="SI.Biz.Core.Events.ExecutionRecorderEventShim" name="Record"/>
</workUnit>
